+  void rebuild_device_section ()
+  {
+    device_section.remove_all ();
+
+    foreach (var device in bluetooth.get_devices ())
+      {
+        if (!device.is_trusted && !device.is_connected)
+          continue;
+
+        var id = device.id;
+        var action_name = @"phone-device-$(id)-connected";
+
+        if (!connect_actions.contains (id))
+          {
+            var a = new SimpleAction.stateful (action_name, VariantType.BOOLEAN,
+                                               new Variant.boolean (device.is_connected));
+            a.activate.connect ((action, param) => a.change_state (param));
+            a.change_state.connect ((action, requested)
+              => bluetooth.set_device_connected (id, requested.get_boolean ()));
+            connect_actions.insert (id, a);
+            action_group.add_action (a);
+          }
+        else
+          connect_actions.lookup (id).set_state (new Variant.boolean (device.is_connected));
+
+        var item = new MenuItem (device.name, @"indicator.$(action_name)(true)");
