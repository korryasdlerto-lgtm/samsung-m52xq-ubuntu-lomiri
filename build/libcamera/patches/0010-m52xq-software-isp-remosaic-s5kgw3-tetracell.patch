+/*
+ * m52xq: 4-cell -> Bayer by moving pixels within each 4x4 block (no interpolation), with the 16 positions of the block
+ * first scaled to the mean of their colour (the pixels of a cell differ slightly in sensitivity: a fine dot grid
+ * otherwise). Port of remosaic_tetracell_raw10() of our Megapixels (r64/r68), done in place on the RAW10 input.
+ */
+void SoftwareIsp::remosaicTetracell(FrameBuffer *input)
+{
+	/* target (GRBG) <- source position in the 4x4 block */
+	static const uint8_t src[4][4][2] = {
+		{ { 0, 0 }, { 0, 2 }, { 0, 1 }, { 0, 3 } },	/* G R G R */
+		{ { 2, 0 }, { 1, 1 }, { 2, 1 }, { 2, 3 } },	/* B G B G */
+		{ { 1, 0 }, { 1, 2 }, { 2, 2 }, { 1, 3 } },	/* G R G R */
+		{ { 3, 0 }, { 3, 2 }, { 3, 1 }, { 3, 3 } },	/* B G B G */
+	};
+	static const int posColour[4][4] = { { 1, 1, 0, 0 }, { 1, 1, 0, 0 }, { 2, 2, 1, 1 }, { 2, 2, 1, 1 } };
+
+	MappedFrameBuffer map(input, MappedFrameBuffer::MapFlag::ReadWrite);
+	if (!map.isValid() || map.planes().empty()) {
+		LOG(SoftwareIsp, Error) << "m52xq: cannot map the 4-cell input";
+		return;
+	}
+	uint8_t *image = map.planes()[0].data();
+	const unsigned int width = remosaicSize_.width, height = remosaicSize_.height;
+	const size_t line = remosaicStride_;
+	if (map.planes()[0].size() < line * height)
+		return;
+
+	double sum[4][4] = {}, cnt[4][4] = {};
+	for (unsigned int y = 0; y + 4 <= height; y += 32) {
+		for (unsigned int gx = 0; gx < width / 4; gx += 8) {
+			for (int r = 0; r < 4; r++) {
+				const uint8_t *p = image + (size_t)(y + r) * line + (size_t)gx * 5;
+				for (int c = 0; c < 4; c++) {
+					int v = ((int)p[c] << 2) | ((p[4] >> (2 * c)) & 3);
+					if (v > 80 && v < 960) {
+						sum[r][c] += v - 64;
+						cnt[r][c] += 1;
+					}
+				}
+			}
+		}
+	}
+	double csum[3] = {}, ccnt[3] = {};
+	for (int r = 0; r < 4; r++)
+		for (int c = 0; c < 4; c++) {
+			csum[posColour[r][c]] += sum[r][c];
+			ccnt[posColour[r][c]] += cnt[r][c];
+		}
+	float gain[4][4];
+	for (int r = 0; r < 4; r++)
+		for (int c = 0; c < 4; c++) {
+			int k = posColour[r][c];
+			double m = cnt[r][c] > 100 ? sum[r][c] / cnt[r][c] : 0;
+			double cm = ccnt[k] > 100 ? csum[k] / ccnt[k] : 0;
+			gain[r][c] = (m > 1 && cm > 1) ? static_cast<float>(cm / m) : 1.0f;
+			if (gain[r][c] < 0.8f || gain[r][c] > 1.25f)
+				gain[r][c] = 1.0f;
+		}
+
+	for (unsigned int y = 0; y + 4 <= height; y += 4) {
+		for (unsigned int gx = 0; gx < width / 4; gx++) {
+			uint16_t s[4][4];
+			for (int r = 0; r < 4; r++) {
+				const uint8_t *p = image + (size_t)(y + r) * line + (size_t)gx * 5;
+				for (int c = 0; c < 4; c++) {
+					int v = ((int)p[c] << 2) | ((p[4] >> (2 * c)) & 3);
+					if (v > 64 && v < 1023) {
+						v = 64 + static_cast<int>((v - 64) * gain[r][c] + 0.5f);
+						v = v > 1023 ? 1023 : v;
+					}
+					s[r][c] = static_cast<uint16_t>(v);
+				}
+			}
+			for (int r = 0; r < 4; r++) {
+				uint8_t *q = image + (size_t)(y + r) * line + (size_t)gx * 5;
+				uint8_t low = 0;
+				for (int c = 0; c < 4; c++) {
+					uint16_t v = s[src[r][c][0]][src[r][c][1]];
+					q[c] = v >> 2;
+					low |= (v & 3) << (2 * c);
+				}
+				q[4] = low;
+			}
+		}
+	}
+}
+
