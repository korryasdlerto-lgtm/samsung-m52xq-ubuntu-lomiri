+static void
+uim_read (MMSimQmi            *self,
+          guint16              file_id,
+          const guint16       *file_path,
+          gsize                file_path_len,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    GTask *task;
+    QmiClient *client = NULL;
+    UimReadContext *ctx;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (!ensure_qmi_client (task,
+                            self,
+                            QMI_SERVICE_UIM, &client))
+        return;
+
+    ctx = g_new0 (UimReadContext, 1);
+    ctx->file_id = file_id;
+    ctx->gsm_fallback = (file_path == adf_file_path);
+    g_task_set_task_data (task, ctx, g_free);
+
+    uim_read_send (task, QMI_CLIENT_UIM (client), file_id, file_path, file_path_len);
