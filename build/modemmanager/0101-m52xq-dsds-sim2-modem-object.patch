     ctx->kernel_data_modes = MM_PORT_QMI_KERNEL_DATA_MODE_NONE;
 
     task = g_task_new (self, cancellable, callback, user_data);
@@ -2877,6 +2973,19 @@ mm_port_qmi_new (const gchar  *name,
                                       NULL));
 }
 
