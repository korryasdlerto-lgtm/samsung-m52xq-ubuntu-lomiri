+guint
+mm_shared_qmi_get_subscription (gpointer self)
+{
+    g_autoptr(MMBaseModem)  modem = NULL;
+    MMPortQmi              *port;
+
+    if (MM_IS_BASE_SIM (self))
+        g_object_get (self, MM_BASE_SIM_MODEM, &modem, NULL);
+    else if (MM_IS_BASE_MODEM (self))
+        modem = g_object_ref (self);
+    if (!modem || !MM_IS_BROADBAND_MODEM_QMI (modem))
+        return 0;
+    port = mm_broadband_modem_qmi_peek_port_qmi (MM_BROADBAND_MODEM_QMI (modem));
+    return port ? mm_port_qmi_get_subscription (port) : 0;
+}
+
+gboolean
+mm_shared_qmi_is_sim2_object (gpointer self)
+{
+    /* both SIMs active: the SIM2 object shares the modem with SIM1 and must not drive global state */
+    return (mm_shared_qmi_get_subscription (self) &&
+            g_getenv ("MM_QRTR_DSDS") && !g_getenv ("MM_QRTR_SIM_ONLY"));
+}
+
+QmiUimSessionType
+mm_shared_qmi_gw_session (gpointer self)
+{
+    return (mm_shared_qmi_get_subscription (self) ?
+            QMI_UIM_SESSION_TYPE_SECONDARY_GW_PROVISIONING :
+            QMI_UIM_SESSION_TYPE_PRIMARY_GW_PROVISIONING);
+}
+
+QmiUimSessionType
+mm_shared_qmi_card_slot_session (gpointer self)
+{
+    /* the m52xq modem maps subscription N to physical slot N + 1 */
+    return (mm_shared_qmi_get_subscription (self) ?
+            QMI_UIM_SESSION_TYPE_CARD_SLOT_2 :
+            QMI_UIM_SESSION_TYPE_CARD_SLOT_1);
+}
+
 QmiClient *
 mm_shared_qmi_peek_client (MMSharedQmi    *self,
                            QmiService      service,
