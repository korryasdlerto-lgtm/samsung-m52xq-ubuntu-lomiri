 }
 
+static void
+allocate_client_done (MMPortQmi             *self,
+                      GTask                 *task,
+                      AllocateClientContext *ctx)
+{
+    /* Move the service info to our internal list */
+    self->priv->services = g_list_prepend (self->priv->services, ctx->info);
+    ctx->info = NULL;
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+bind_subscription_ready (QmiDevice    *qmi_device,
+                         GAsyncResult *res,
+                         GTask        *task)
+{
+    MMPortQmi             *self;
+    AllocateClientContext *ctx;
+    g_autoptr(QmiMessage)  response = NULL;
+    GError                *error = NULL;
+    gsize                  offset = 0;
+    gsize                  init_offset;
+    guint16                result = 1;
+    guint16                qmi_error = 0;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+
+    response = qmi_device_command_full_finish (qmi_device, res, &error);
+    if (response &&
+        ((init_offset = qmi_message_tlv_read_init (response, 0x02, NULL, &error)) > 0) &&
+        qmi_message_tlv_read_guint16 (response, init_offset, &offset, QMI_ENDIAN_LITTLE, &result, &error) &&
+        qmi_message_tlv_read_guint16 (response, init_offset, &offset, QMI_ENDIAN_LITTLE, &qmi_error, &error) &&
+        result != 0)
+        error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "QMI error %u", qmi_error);
+
+    if (error) {
+        g_prefix_error (&error, "Couldn't bind client for service '%s' to subscription %u: ",
+                        qmi_service_get_string (ctx->info->service), self->priv->subscription);
+        qmi_device_release_client (qmi_device, ctx->info->client,
+                                   QMI_DEVICE_RELEASE_CLIENT_FLAGS_RELEASE_CID, 3, NULL, NULL, NULL);
+        g_clear_object (&ctx->info->client);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "client for service '%s' bound to subscription %u",
+                qmi_service_get_string (ctx->info->service), self->priv->subscription);
+    allocate_client_done (self, task, ctx);
+}
+
+/* m52xq DSDS: NAS/Voice/WMS (0 = SIM1, 1 = SIM2) and WDS (QmiSubscriptionType, 1 = primary) bind a client
+ * to a subscription; libqmi has no NAS/Voice/WMS message for it, so the request is built by hand */
+static gboolean
+bind_subscription (MMPortQmi             *self,
+                   GTask                 *task,
+                   AllocateClientContext *ctx)
+{
+    g_autoptr(QmiMessage)  request = NULL;
+    QmiClient             *client = ctx->info->client;
+    guint16                message_id;
+    gsize                  tlv;
+
+    switch (ctx->info->service) {
+    case QMI_SERVICE_NAS:   message_id = 0x0045; break;
+    case QMI_SERVICE_VOICE: message_id = 0x0044; break;
+    case QMI_SERVICE_WMS:   message_id = 0x004C; break;
+    case QMI_SERVICE_WDS:   message_id = 0x00AF; break;
+    default:
+        return FALSE;
+    }
+
+    request = qmi_message_new (ctx->info->service,
+                               qmi_client_get_cid (client),
+                               qmi_client_get_next_transaction_id (client),
+                               message_id);
+    tlv = qmi_message_tlv_write_init (request, 0x01, NULL);
+    if (ctx->info->service == QMI_SERVICE_WDS)
+        qmi_message_tlv_write_guint32 (request, QMI_ENDIAN_LITTLE, self->priv->subscription + 1, NULL);
+    else
+        qmi_message_tlv_write_guint8 (request, self->priv->subscription, NULL);
+    qmi_message_tlv_write_complete (request, tlv, NULL);
+
+    qmi_device_command_full (self->priv->qmi_device, request, NULL, 10, NULL,
+                             (GAsyncReadyCallback)bind_subscription_ready, task);
+    return TRUE;
+}
+
