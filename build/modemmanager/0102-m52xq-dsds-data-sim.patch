diff --git a/src/mm-base-manager.c b/src/mm-base-manager.c
index d433553..5540e7a 100644
--- a/src/mm-base-manager.c
+++ b/src/mm-base-manager.c
@@ -503,6 +503,32 @@ additional_port (MMBaseManager  *self,
                             g_object_ref (self));
 }
 
+/* m52xq DSDS: both SIMs active, and (r7) which SIM modem object owns the data port */
+static gboolean
+m52xq_dual_sim (void)
+{
+    return g_getenv ("MM_QRTR_DSDS") && !g_getenv ("MM_QRTR_SIM_ONLY");
+}
+
+static gboolean
+m52xq_data_sim2 (void)
+{
+    return m52xq_dual_sim () && !g_strcmp0 (g_getenv ("MM_QRTR_DATA_SIM"), "2");
+}
+
+/* The physical device of a port; with the mobile data on SIM2 the SoC net port (physdev qcom-soc) goes to the
+ * SIM2 device qcom-soc-sim2 instead, so that the SIM names stay the same (qcom-soc = SIM1, -sim2 = SIM2) */
+static const gchar *
+m52xq_port_physdev_uid (MMKernelDevice *port)
+{
+    const gchar *uid = mm_kernel_device_get_physdev_uid (port);
+
+    if (m52xq_data_sim2 () && !g_strcmp0 (uid, "qcom-soc") &&
+        !g_strcmp0 (mm_kernel_device_get_subsystem (port), "net"))
+        return "qcom-soc-sim2";
+    return uid;
+}
+
 static void
 first_port (MMBaseManager  *self,
             MMKernelDevice *port,
@@ -514,7 +540,7 @@ first_port (MMBaseManager  *self,
     const gchar         *physdev;
 
     name = mm_kernel_device_get_name (port);
-    uid = mm_kernel_device_get_physdev_uid (port);
+    uid = m52xq_port_physdev_uid (port);
 
     mm_obj_dbg (self, "port %s is first in device '%s'", name, uid);
 
@@ -571,7 +597,7 @@ device_added (MMBaseManager  *self,
 
     /* Get the port's physical device's uid. All ports of the same physical
      * device will share the same uid. */
-    uid = mm_kernel_device_get_physdev_uid (port);
+    uid = m52xq_port_physdev_uid (port);
     g_assert (uid);
 
     /* If the device is inhibited, do nothing else */
@@ -620,17 +646,21 @@ handle_qrtr_device_added (MMBaseManager    *self,
     /* m52xq DSDS (m52xq-sim-mode): MM_QRTR_SIM_ONLY=2 -> the only modem object is SIM2 (QMI clients
      * bound to subscription 1, with the data port); otherwise SIM1, and with MM_QRTR_DSDS (both SIMs
      * active, the modem keeps both registered) SIM2 gets a second modem object of its own */
+    /* r7: with both SIMs active MM_QRTR_DATA_SIM=2 gives the data port (rmnet) to the SIM2 modem object (see
+     * m52xq_port_physdev_uid()); the modem's own data subscription (DDS) is switched by m52xq-sim-mode */
     if (!g_strcmp0 (g_getenv ("MM_QRTR_SIM_ONLY"), "2"))
-        kernel_device = mm_kernel_device_qrtr_new_for_subscription (node, 1, FALSE);
+        kernel_device = mm_kernel_device_qrtr_new_for_subscription (node, 1, FALSE, FALSE);
+    else if (m52xq_data_sim2 ())
+        kernel_device = mm_kernel_device_qrtr_new_for_subscription (node, 0, FALSE, TRUE);
     else
         kernel_device = mm_kernel_device_qrtr_new (node);
 
     device_added (self, kernel_device, TRUE, FALSE);
 
-    if (g_getenv ("MM_QRTR_DSDS") && !g_getenv ("MM_QRTR_SIM_ONLY")) {
+    if (m52xq_dual_sim ()) {
         g_autoptr(MMKernelDevice) sim2_device = NULL;
 
-        sim2_device = mm_kernel_device_qrtr_new_for_subscription (node, 1, TRUE);
+        sim2_device = mm_kernel_device_qrtr_new_for_subscription (node, 1, TRUE, !m52xq_data_sim2 ());
         device_added (self, sim2_device, TRUE, FALSE);
     }
 }
