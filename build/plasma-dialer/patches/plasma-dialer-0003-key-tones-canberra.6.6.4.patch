--- a/plasma-dialer/src/keytones.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/plasma-dialer/src/keytones.cpp	2026-10-03 00:31:44.460809115 +0300
@@ -0,0 +1,57 @@
+// SPDX-FileCopyrightText: 2026 m52xq port
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "keytones.h"
+
+#include <QRegularExpression>
+#include <QFile>
+#include <QStandardPaths>
+#include <canberra.h>
+
+// The dial pad tones follow the on-screen keyboard setting "Sound" (plasmakeyboardrc, [General] soundEnabled).
+// Read on every press so toggling it in the settings applies at once; default off, like the keyboard.
+static bool keySoundEnabled()
+{
+    QFile f(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/plasmakeyboardrc"));
+    if (!f.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return false;
+    }
+    while (!f.atEnd()) {
+        const QByteArray line = f.readLine().trimmed();
+        if (line.startsWith("soundEnabled=")) {
+            return line.mid(13).trimmed().toLower() == "true";
+        }
+    }
+    return false;
+}
+
+KeyTones::KeyTones(QObject *parent)
+    : QObject(parent)
+{
+    if (ca_context_create(&m_context) == CA_SUCCESS) {
+        ca_context_change_props(m_context, CA_PROP_APPLICATION_NAME, "Phone", CA_PROP_APPLICATION_ID, "org.kde.plasma.dialer", nullptr);
+        ca_context_open(m_context);
+    } else {
+        m_context = nullptr;
+    }
+}
+
+KeyTones::~KeyTones()
+{
+    if (m_context) {
+        ca_context_destroy(m_context);
+    }
+}
+
+void KeyTones::play(const QString &name)
+{
+    static const QRegularExpression valid(QStringLiteral("^([0-9]|star|hash|delete|clear)$"));
+    if (!m_context || !valid.match(name).hasMatch() || !keySoundEnabled()) {
+        return;
+    }
+    const QByteArray file = QStringLiteral("/usr/share/sounds/m52xq/dtmf-%1.wav").arg(name).toUtf8();
+    const QByteArray id = QStringLiteral("m52xq-dtmf-%1").arg(name).toUtf8();
+    // one tone at a time: a new key press cuts the previous tone
+    ca_context_cancel(m_context, 1);
+    ca_context_play(m_context, 1, CA_PROP_EVENT_ID, id.constData(), CA_PROP_MEDIA_FILENAME, file.constData(), CA_PROP_CANBERRA_CACHE_CONTROL, "permanent", nullptr);
+}

--- a/plasma-dialer/src/keytones.h	1970-01-01 02:00:00.000000000 +0200
+++ b/plasma-dialer/src/keytones.h	2026-10-03 00:31:44.460809115 +0300
@@ -0,0 +1,28 @@
+// SPDX-FileCopyrightText: 2026 m52xq port
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+#include <qqmlregistration.h>
+
+struct ca_context;
+
+// Dial pad key tones played through libcanberra (PulseAudio), the same path
+// as canberra-gtk-play; QtMultimedia SoundEffect crackled on short tones.
+class KeyTones : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    QML_SINGLETON
+
+public:
+    explicit KeyTones(QObject *parent = nullptr);
+    ~KeyTones() override;
+
+    // name: "0".."9", "star", "hash", "delete", "clear"
+    Q_INVOKABLE void play(const QString &name);
+
+private:
+    ca_context *m_context = nullptr;
+};

