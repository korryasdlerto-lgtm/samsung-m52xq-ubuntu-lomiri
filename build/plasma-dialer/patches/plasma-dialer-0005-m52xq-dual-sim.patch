 #include "mm-modem-controller.h"
 
+#include <algorithm>
+
+/*
+ * m52xq dual SIM (both SIMs active, one ModemManager modem object per SIM): SIM1 first, then SIM2 (the modem
+ * device "qcom-soc-sim2"), and the modem of a call found from the call itself. The dialer passes no modem with
+ * several modems ("TODO: select device uni"), so without this calls could not be made, answered or hung up.
+ */
+static bool m52xqIsSim2(const QSharedPointer<ModemManager::ModemDevice> &device)
+{
+    const auto modem = device->modemInterface();
+    return modem && modem->device().endsWith(QLatin1String("-sim2"));
+}
+
+static ModemManager::ModemDevice::List m52xqModemDevices()
+{
+    auto devices = ModemManager::modemDevices();
+    std::stable_sort(devices.begin(), devices.end(), [](const auto &a, const auto &b) {
+        return !m52xqIsSim2(a) && m52xqIsSim2(b);
+    });
+    return devices;
+}
+
+static QSharedPointer<ModemManager::ModemDevice> m52xqModemFor(const QString &deviceUni, const QString &callUni)
+{
+    const auto modem = ModemManager::findModemDevice(deviceUni);
+    if (!callUni.isEmpty()) {
+        auto devices = m52xqModemDevices();
+        if (!modem.isNull())
+            devices.prepend(modem);
+        for (const auto &device : std::as_const(devices)) {
+            const auto voice = device->interface(ModemManager::ModemDevice::VoiceInterface).objectCast<ModemManager::ModemVoice>();
+            if (voice && !voice->findCall(callUni).isNull())
+                return device;
+        }
+    }
+    if (!modem.isNull() || !deviceUni.isEmpty())
+        return modem;
+    const auto devices = m52xqModemDevices();
+    return devices.isEmpty() ? modem : devices.first(); // no modem given: SIM1
+}
