+int MessageModel::simFor(const Message &message) const
+{
+    // m52xq: the daemon writes "in:<ms>" / "out:<id>" -> SIM into ~/.local/share/spacebar/message-sim
+    const QString path = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + SL("/spacebar/message-sim");
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    if (now - m_simsStamp > 1500) {
+        m_simsStamp = now;
+        m_sims.clear();
+        QFile f(path);
+        if (f.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            while (!f.atEnd()) {
+                const QList<QByteArray> parts = f.readLine().trimmed().split(' ');
+                if (parts.size() == 2) {
+                    m_sims.insert(QString::fromUtf8(parts[0]), parts[1].toInt());
+                }
+            }
+        }
+    }
+    const QString key = message.sentByMe ? QString(SL("out:") + message.id) : QString(SL("in:") + QString::number(message.datetime.toMSecsSinceEpoch()));
+    return m_sims.value(key, 0);
+}
