 struct ath11k_ahb {
 	struct rproc *tgt_rproc;
+	/* m52xq: POWER_SAVE_ENTER was sent at system suspend with the radio off */
+	bool m52xq_off_ps;
 	struct {
 		struct device *dev;
 		struct iommu_domain *iommu_domain;
