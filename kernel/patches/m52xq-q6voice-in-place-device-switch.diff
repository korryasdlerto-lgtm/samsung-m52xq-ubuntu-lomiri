+/*
+ * m52xq: in-place device switch of a running call, as downstream msm-pcm-routing does:
+ * removing the Rx route of the running path pauses the call (voc_disable_device), routing
+ * it to the new (already started) backend moves the vocproc there with SET_DEVICE, sends
+ * media format, topology commit and calibration of the new device and starts the call
+ * again (voc_enable_device). Called by the Rx voice mixer controls.
+ */
+void q6voice_device_pause(struct q6voice *v, enum q6voice_path_type path)
+{
+	struct q6voice_path *p = &v->paths[path];
+	struct q6voice_session *mvm;
+	int ret;
+
+	if (!device_switch)
+		return;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime || p->runtime->started != 3 || p->runtime->paused)
+		goto out;
+	mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	if (!mvm || !p->runtime->sessions[Q6VOICE_SERVICE_CVP])
+		goto out;
+
+	ret = q6mvm_pause(mvm);
+	if (ret)
+		dev_err(v->dev, "m52xq: voice device switch: pause failed: %d\n", ret);
+	p->runtime->paused = true;
+	dev_info(v->dev, "m52xq: voice device switch: paused (rx port %d)\n", p->rx_port);
+out:
+	mutex_unlock(&p->lock);
+}
+EXPORT_SYMBOL_GPL(q6voice_device_pause);
+
+void q6voice_device_resume(struct q6voice *v, enum q6voice_path_type path)
+{
+	struct q6voice_path *p = &v->paths[path];
+	struct q6voice_session *mvm, *cvp;
+	u16 tx_port, rx_port;
+	int ret;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime || !p->runtime->paused || !p->rx_port)
+		goto out;
+	mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	tx_port = q6afe_get_port_id(p->tx_port);
+	rx_port = q6afe_get_port_id(p->rx_port);
+
+	ret = q6cvp_set_device(cvp, tx_port, rx_port);
+	if (ret) {
+		dev_err(v->dev, "m52xq: voice device switch failed: set device %#x/%#x: %d\n",
+			tx_port, rx_port, ret);
+		goto start;
+	}
+	ret = q6cvp_set_media(cvp, rx_port, 2, tx_port, 2, 48000);
+	if (ret)
+		dev_err(v->dev, "m52xq: voice device switch failed: media format: %d\n", ret);
+start:
+	p->runtime->paused = false;
+	ret = q6mvm_start(mvm, true);
+	if (ret)
+		dev_err(v->dev, "m52xq: voice device switch failed: start: %d\n", ret);
+	if (q6cvp_dev_unmute_enabled()) {
+		q6cvp_set_mute(cvp, 0, false);
+		q6cvp_set_mute(cvp, 1, false);
+	}
+	dev_info(v->dev, "m52xq: voice device switch: running on rx port %#x\n", rx_port);
+out:
+	mutex_unlock(&p->lock);
+}
+EXPORT_SYMBOL_GPL(q6voice_device_resume);
+
