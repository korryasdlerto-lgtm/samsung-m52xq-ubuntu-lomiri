+#define VSS_IVOCPROC_CMD_SET_DEVICE_V3			0x0001316A
+
+struct vss_ivocproc_cmd_set_device_cmd {
+	struct apr_hdr hdr;
+	u16 tx_port_id;
+	u32 tx_topology_id;
+	u16 rx_port_id;
+	u32 rx_topology_id;
+	u32 vocproc_mode;
+	u16 ec_ref_port_id;
+} __packed;
+
+/*
+ * m52xq: move a paused vocproc to other device ports (downstream voc_enable_device() ->
+ * voice_send_set_device_cmd(), V3 for CVD >= 2.2) instead of destroying and re-creating it:
+ * re-created vocprocs attached in the middle of a call crashed the ADSP audio PD while
+ * their calibration was sent (AfeDyb030, 3rd-4th session of a call).
+ */
+int q6cvp_set_device(struct q6voice_session *cvp, u16 tx_port, u16 rx_port)
+{
+	struct vss_ivocproc_cmd_set_device_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOCPROC_CMD_SET_DEVICE_V3;
+	cmd.tx_port_id = tx_port;
+	cmd.tx_topology_id = tx_topology;
+	cmd.rx_port_id = rx_port;
+	cmd.rx_topology_id = rx_topology;
+	cmd.vocproc_mode = vocproc_mode;
+	cmd.ec_ref_port_id = VSS_IVOCPROC_PORT_ID_NONE;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_set_device);
