Exec=/usr/local/bin/m52xq-app-env lomiri-clock-app
Icon=/usr/share/lomiri-clock-app/clock-app.svg
Terminal=false
Type=Application
X-Lomiri-Touch=true
X-Lomiri-Default-Department-ID=accessories
# splash->app transition moves the window due to minimum{Width,Height} settings
# which may move app's top bar off the screen
X-Lomiri-Splash-Show=false
X-Lomiri-Splash-Image=/usr/share/lomiri-clock-app/clock-app-splash.svg
X-Lomiri-Splash-Color=#4d4d4d
OnlyShowIn=Lomiri;
