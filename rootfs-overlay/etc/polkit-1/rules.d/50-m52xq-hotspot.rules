// M52XQ: the user may start and stop the hotspot service from the quick setting without a password
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "m52xq-hotspot.service" &&
        subject.user == "user") {
        return polkit.Result.YES;
    }
});
