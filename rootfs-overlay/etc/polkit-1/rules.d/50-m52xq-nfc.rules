// M52XQ: the user may switch NFC on and off from the quick setting without a password
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "m52xq-nfc@on.service" || action.lookup("unit") == "m52xq-nfc@off.service") &&
        subject.user == "user") {
        return polkit.Result.YES;
    }
});
