// M52XQ: the "SIM cards" and "Flight mode" buttons may start m52xq-sim-mode@<mode> / m52xq-flight-mode@on|off without a password (active local user)
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    action.lookup("verb") == "start" &&
	    (/^m52xq-sim-mode@(dsds|sim1|sim2|data1|data2)\.service$/.test(action.lookup("unit")) ||
	     /^m52xq-flight-mode@(on|off)\.service$/.test(action.lookup("unit"))) &&
	    subject.local && subject.active)
		return polkit.Result.YES;
});
