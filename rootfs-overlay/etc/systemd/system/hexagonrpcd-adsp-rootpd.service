[Unit]
Description=M52XQ: FastRPC server for the ADSP root PD
After=m52xq-adsp-start.service
Conflicts=suspend.target
Before=suspend.target

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 120); do [ -e /dev/fastrpc-adsp ] && exit 0; sleep 1; done; exit 1'
TimeoutStartSec=150
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -R /usr/share/qcom/sm7325/Samsung/m52xq
Restart=always
RestartSec=3
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
