[Unit]
Description=M52XQ: Modem Daemon (ModemManager) of plasma-dialer
# the packages ship these only as XDG autostart files; the systemd generator makes app-org.kde.*@autostart.service for them, but
# xdg-desktop-autostart.target is not started in the Lomiri session ("Службы телефонии не отвечают" in the dialer after a reboot)
After=graphical-session-pre.target
PartOf=ubuntu-touch-session.target

[Service]
ExecStart=/usr/lib/aarch64-linux-gnu/libexec/modem-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=ubuntu-touch-session.target
