# M52XQ: accel + light + proximity (libssc patched: skip Samsung extra proximity states 2/4).
# lsm6dsm on M52: upright portrait reads Y=+g; iio-sensor-proxy wants Y=-g (normal) -> rotate 180 deg.
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-accel ssc-light ssc-proximity", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, 1"
