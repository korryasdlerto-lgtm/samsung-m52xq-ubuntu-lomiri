#!/bin/sh
# M52XQ (root, started by m52xq-gps-perms.path): turn the user's per-app
# location list ~user/.config/m52xq-geoclue-apps ("<desktop-id>=allow|deny"
# per line) into a GeoClue conf.d file. Only strictly validated ids are used.
SRC=/home/user/.config/m52xq-geoclue-apps
DST=/etc/geoclue/conf.d/90-m52xq-apps.conf
TMP="$DST.tmp"
[ -f "$SRC" ] || exit 0
{
	echo "# generated by m52xq-gps-apply-perms, do not edit"
	while IFS='=' read -r app val; do
		case "$app" in ''|*[!A-Za-z0-9._-]*) continue ;; esac
		case "$val" in
		allow) a=true ;;
		deny) a=false ;;
		*) continue ;;
		esac
		printf '[%s]\nallowed=%s\nsystem=false\nusers=\n\n' "$app" "$a"
	done < "$SRC"
} > "$TMP" && mv "$TMP" "$DST"
systemctl try-restart geoclue.service 2>/dev/null
exit 0
