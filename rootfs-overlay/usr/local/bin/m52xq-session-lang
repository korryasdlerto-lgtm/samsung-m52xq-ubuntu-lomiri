#!/bin/sh
# m52xq classic в8: the language of the user's session for Lomiri and the shade indicators. Lomiri runs as the systemd user
# service lomiri-full-greeter.service (not through m52xq-start-lomiri): it and the indicators started after it took the user
# manager's environment, LANG=en_US.UTF-8 of /etc/default/locale with the greeter's LANGUAGE=ru (translations Russian, date /
# number formats English, 2026-11-08). Run as ExecStartPre of that service: the language chosen in the first-run wizard /
# System Settings (AccountsService "Languages") goes into the user manager and D-Bus activation environment. Nothing is set
# when no language was chosen yet (the system default stays).
l=$(busctl --system get-property org.freedesktop.Accounts "/org/freedesktop/Accounts/User$(id -u)" \
	org.freedesktop.Accounts.User Languages 2>/dev/null | sed -n 's/^as [1-9][0-9]* "\([^"]*\)".*/\1/p')
[ "$l" = en ] && l=en_US	# AccountsService reports en_US as "en": there is no en.UTF-8 locale
[ -n "$l" ] || exit 0
l=${l%%.*}
dbus-update-activation-environment --systemd LANG="$l.UTF-8" LANGUAGE="$l" 2>/dev/null \
	|| systemctl --user set-environment LANG="$l.UTF-8" LANGUAGE="$l"
exit 0
