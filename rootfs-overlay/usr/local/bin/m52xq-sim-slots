#!/bin/sh
# m52xq (убунтутач24/003, в4): which SIM (slot 1 / 2) has which ICCID, for the call log of the dialer (History.account = ICCID).
# ModemManager device qcom-soc = SIM 1, qcom-soc-sim2 = SIM 2. Writes "ICCID N" per line to /run/m52xq-sim-slots (world readable).
out=/run/m52xq-sim-slots
i=0
while [ $i -lt 45 ]; do
	tmp=$(mktemp)
	for m in $(mmcli -L 2>/dev/null | grep -o "Modem/[0-9]*" | cut -d/ -f2); do
		info=$(mmcli -m "$m" -K 2>/dev/null)
		dev=$(echo "$info" | sed -n 's/^modem.generic.device  *: *//p')
		sim=$(echo "$info" | sed -n 's/^modem.generic.sim  *: *//p')
		[ -n "$sim" ] && [ "$sim" != "--" ] || continue
		iccid=$(mmcli -i "${sim##*/}" -K 2>/dev/null | sed -n 's/^sim.properties.iccid  *: *//p')
		[ -n "$iccid" ] || continue
		case "$dev" in
		*sim2) echo "$iccid 2" >> "$tmp" ;;
		*) echo "$iccid 1" >> "$tmp" ;;
		esac
	done
	if [ "$(wc -l < "$tmp")" -ge 1 ]; then
		cat "$tmp" > "$out"; chmod 644 "$out"; rm -f "$tmp"
		[ "$(wc -l < "$out")" -ge 2 ] && exit 0
	else
		rm -f "$tmp"
	fi
	i=$((i + 1)); sleep 2
done
exit 0
