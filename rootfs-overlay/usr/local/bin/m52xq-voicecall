#!/usr/bin/env python3
# M52XQ: bring the modem voice path up for the length of a call.
#
# CS voice runs ADSP(q6voice) <-> LPASS codec DMA <-> WCD938x without PulseAudio.
# While a ModemManager call is dialing / ringing out / active this service sets
# the codec mixers (m52xq-voice-mixers.sh) and keeps the CS-Voice PCMs open
# (m52xq-voice-hold.py -- the voice session starts when both directions are up).
# Event driven: ModemManager signals (Voice CallAdded/CallDeleted, Call
# StateChanged); a slow timer re-checks in case a signal was missed.
import json
import math
import os
import re
import signal
import subprocess
import sys
import time

import gi
gi.require_version('GLibUnix', '2.0')
from gi.repository import Gio, GLib, GLibUnix

MM = 'org.freedesktop.ModemManager1'
CALL_VOICE_STATES = {1, 2, 4}      # MMCallState: dialing, ringing-out, active
CALL_STATE_ACTIVE = 4
# v40: no voice session restart (route switch) in the first seconds of the active call: when the call turns active the
# modem reconfigures the voice itself; a session re-created then crashed the ADSP audio PD (23.10 17:10:07, 0.9 s after
# "active", the dialer reset the loud speaker); route switches later in the call were fine (5 in a row at 17:09)
SETTLE_S = 3.0
# m52xq (в43): loud speaker silence. The TFA9878 amplifier (I2C behind gpi-dma 900000) is configured when the route is switched; in
# ~half of the switches the GPI DMA reports "Event without a pending descriptor!" and the amplifier stays silent (the 3rd try works).
# After a loud speaker switch the kernel log is checked AMP_CHECK_S later and the route is re-created (at most AMP_RETRIES times).
AMP_CHECK_S = 2.5
AMP_RETRIES = 2
GPI_ERR = 'Event without a pending descriptor'
# v40 dual SIM (boot v231): the ADSP voice session of the SIM with the call. SIM1 runs in VoiceMMode1 (VSID
# 0x11C05000), SIM2 (ModemManager modem device "qcom-soc-sim2") in VoiceMMode2 (0x11DC5000), like the stock HAL.
VOICE_SESSION = '/sys/module/q6mvm/parameters/voice_session'
DEVICE_SWITCH = '/sys/module/q6voice/parameters/device_switch'	# kernel with the in-place device switch
SWITCH_ERR = 'voice device switch failed'
SESSION_SIM1, SESSION_SIM2 = '11C05000', '11DC5000'
SAFETY_S = 20
MIXERS = '/usr/local/bin/m52xq-voice-mixers.sh'
HOLD = ['/usr/bin/python3', '-u', '/usr/local/bin/m52xq-voice-hold.py']
BRIDGE = ['/usr/bin/python3', '-u', '/usr/local/bin/m52xq-usb-call-bridge']
PLAYBACK_PARAM = '/sys/module/q6voice/parameters/playback_uplink'
RECORD_PARAM = '/sys/module/q6voice/parameters/record_uplink'	# kernel: feed VOICE_PLAYBACK_TX into the voice Tx stream
CVP_PARAMS = '/sys/module/q6cvp/parameters'
CVP_USB = {'tx_topology': '0x10F70', 'rx_topology': '0x10F77', 'tx_channels': '1', 'cal_enable': 'N'}	# vocproc in USB headset mode
PULSE = ['pactl']
PULSE_ENV = dict(os.environ, PULSE_SERVER='unix:/run/user/10000/pulse/native', PULSE_COOKIE='/home/user/.config/pulse/cookie')
STATE_FILE = '/run/user/10000/m52xq-callaudio.json'	# written by m52xq-callaudiod (shell call buttons)
CONTROL_POLL_MS = 400
TX_GAIN = 106		# TX_DEC0 Volume in a call (+22 dB re 0 dB = 84), see m52xq-voice-mixers.sh
TX_MUTED = 0		# TX_DEC0 Volume 0 = -84 dB
RX_ZERO_DB = 84		# RX_RX0 Digital Volume: 84 = 0 dB, 1 dB per step
RX_MAX = 90		# +6 dB at 100 % of the PulseAudio sink volume
AMP_FULL = 195		# TFA9878 "Speaker Amp Gain" default (0xc3); the field is LINEAR (measured 2026-10-04: output amplitude ~ 0.87 * value)
AMP_RANGE_DB = 36	# loud speaker: 0 % = -36 dB below AMP_FULL


def pulse(*args):
    try:
        return subprocess.run(PULSE + list(args), capture_output=True, text=True, timeout=3, env=PULSE_ENV).stdout
    except Exception:
        return ''


def read_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def mixer(name, value):
    subprocess.run(['amixer', '-q', '-c0', 'cset', 'name=' + name, str(value)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def log(msg):
    print('m52xq-voicecall: ' + msg, flush=True)


class VoiceCall:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.loop = GLib.MainLoop()
        self.up = False
        self.hold = None
        self.muted = False
        self.speaker = False
        self.rx_volume = None
        self.usb = False
        self.headset = False
        self.usb_failed = False
        self.polls = 0
        self.bridge = None
        self.cvp_saved = None
        self.active_since = None

    def usb_headset(self):
        """A USB headset (separate USB audio card) is plugged in and the kernel can inject audio into the call."""
        if not os.path.exists(PLAYBACK_PARAM):
            return False
        return subprocess.run(BRIDGE + ['find'], capture_output=True, env=PULSE_ENV).returncode == 0

    def set_playback(self, on):
        # playback_uplink: voice Tx gets the audio of VOICE_PLAYBACK_TX; record_uplink: the DSP taps the Rx/Tx streams to the
        # VOICE_RECORD pseudo ports (the bridge reads the downlink from VOICE_RECORD_RX) - both are started with the voice session
        for param in (PLAYBACK_PARAM, RECORD_PARAM):
            try:
                with open(param, 'w') as f:
                    f.write('1' if on else '0')
            except OSError:
                pass
        self.set_usb_vocproc(on)

    def set_usb_vocproc(self, on):
        # the Samsung two-mic topology (noise suppression, m52xq-voice-ns) + calibration silence the headset voice injected
        # into the Tx stream (tested 2026-10-17: far end hears nothing; with NONE / 1 channel / no calibration it does):
        # in headset mode the vocproc gets the plain topology, the saved settings come back for the earpiece / loud speaker
        if on:
            if self.cvp_saved is None:
                saved = {}
                for name in CVP_USB:
                    try:
                        with open(os.path.join(CVP_PARAMS, name)) as f:
                            saved[name] = f.read().strip()
                    except OSError:
                        pass
                self.cvp_saved = saved
            values = CVP_USB
        elif self.cvp_saved is not None:
            values, self.cvp_saved = self.cvp_saved, None
        else:
            return
        for name, value in values.items():
            try:
                with open(os.path.join(CVP_PARAMS, name), 'w') as f:
                    f.write(value)
            except OSError:
                pass
        log('vocproc for the USB headset: %s' % ' '.join('%s=%s' % kv for kv in values.items()))

    def bridge_start(self):
        self.bridge = subprocess.Popen(BRIDGE, stdout=sys.stdout, stderr=sys.stderr)

    def bridge_stop(self):
        if self.bridge:
            self.bridge.terminate()
            try:
                self.bridge.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.bridge.kill()
            self.bridge = None

    def call_active(self):
        """the voice session of the SIM with a call in CALL_VOICE_STATES, None without a call"""
        try:
            res = self.bus.call_sync(MM, '/org/freedesktop/ModemManager1',
                                     'org.freedesktop.DBus.ObjectManager', 'GetManagedObjects',
                                     None, GLib.VariantType('(a{oa{sa{sv}}})'),
                                     Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return None
        for ifaces in res.unpack()[0].values():
            voice = ifaces.get(MM + '.Modem.Voice')
            if not voice:
                continue
            sim2 = ifaces.get(MM + '.Modem', {}).get('Device', '').endswith('-sim2')
            for path in voice.get('Calls', []):
                try:
                    st = self.bus.call_sync(MM, path, 'org.freedesktop.DBus.Properties', 'Get',
                                            GLib.Variant('(ss)', (MM + '.Call', 'State')),
                                            GLib.VariantType('(v)'), Gio.DBusCallFlags.NONE, 2000, None)
                except GLib.Error:
                    continue
                state = st.unpack()[0]
                if state in CALL_VOICE_STATES:
                    if state == CALL_STATE_ACTIVE:
                        if self.active_since is None:
                            self.active_since = time.monotonic()
                    else:
                        self.active_since = None
                    return SESSION_SIM2 if sim2 else SESSION_SIM1
        self.active_since = None
        return None

    def settled(self):
        """the call is active for SETTLE_S: the voice session may be re-created (route switch)"""
        self.call_active()
        return self.active_since is not None and time.monotonic() - self.active_since >= SETTLE_S

    def set_session(self, session):
        try:
            with open(VOICE_SESSION) as f:
                if f.read().strip() == session:
                    return
            with open(VOICE_SESSION, 'w') as f:
                f.write(session)
            log('voice session %s (%s)' % (session, 'SIM2' if session == SESSION_SIM2 else 'SIM1'))
        except OSError:
            pass	# kernel before v231: one session (SIM1) only

    def start(self, session=SESSION_SIM1):
        self.set_session(session)
        self.session = session
        # v40: while dialing / ringing out the loud speaker flag can still be the one of the previous call (the dialer
        # resets it when the call turns active): start on the earpiece then, a real choice is applied once settled
        want_speaker = bool(read_state().get('speaker')) and self.active_since is not None
        self.usb_failed = False
        self.headset = self.usb_headset()
        self.usb = self.headset and not want_speaker	# the loud speaker button wins over the headset
        self.speaker = want_speaker
        self.set_playback(self.usb)
        subprocess.run([MIXERS, 'start'] + (['speaker'] if self.speaker else []), stdout=subprocess.DEVNULL)
        self.hold = subprocess.Popen(HOLD, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if self.usb:
            # the phone microphone and the earpiece stay silent: the headset carries the call
            mixer('TX_DEC0 Volume', TX_MUTED)
            mixer('RX_RX0 Digital Volume', 0)
            time.sleep(1.5)
            self.bridge_start()
            log('USB headset bridge on')
        self.up = True
        self.muted = False
        self.rx_volume = None
        self.polls = 0
        self.poll_controls()
        log('call up: voice path on')

    def stop(self):
        self.bridge_stop()
        if self.usb:
            self.set_playback(False)
            self.usb = False
        if self.hold:
            self.hold.terminate()
            try:
                self.hold.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.hold.kill()
            self.hold = None
        subprocess.run([MIXERS, 'stop'], stdout=subprocess.DEVNULL)
        mixer('RX_RX0 Digital Volume', RX_ZERO_DB)
        mixer('Speaker Amp Gain', AMP_FULL)
        if self.up:
            log('call over: voice path off')
            # classic в6: plasma-dialer does not call SelectMode(0) at the end of the call: the speaker flag of a call ended on the loud
            # speaker stayed set, the next call went to the earpiece with the dialer's speaker button shown on. Reset it here.
            try:
                subprocess.run(['su', 'user', '-s', '/bin/sh', '-c',
                                'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/10000/bus busctl --user call org.mobian_project.CallAudio '
                                '/org/mobian_project/CallAudio org.mobian_project.CallAudio SelectMode u 0'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            except Exception:
                pass
        self.up = False

    def recheck(self):
        active = self.call_active()
        if active and not self.up:
            self.start(active)
        elif not active and self.up:
            self.stop()
        elif self.up and active != getattr(self, 'session', SESSION_SIM1):
            log('the call moved to the other SIM, restarting the voice path')
            self.stop()
            self.start(active)
        elif self.up and self.hold and self.hold.poll() is not None:
            log('CS-Voice holder exited, restarting')
            self.stop()
            self.start(active)

    def kernel_log_since(self, t0):
        try:
            return subprocess.run(['journalctl', '-k', '-b', '--no-pager', '--since', '@%d' % int(t0)],
                                  capture_output=True, text=True, timeout=10).stdout
        except Exception:
            return ''

    def gpi_errors_since(self, t0):
        """Number of GPI DMA errors in the kernel log since the unix time t0."""
        return self.kernel_log_since(t0).count(GPI_ERR)

    def check_speaker_amp(self, t0):
        """After a loud speaker start: GPI error in the kernel log = the amplifier was not configured -> redo the route."""
        if not self.speaker or self.usb:
            self.amp_retries = 0
            return
        time.sleep(AMP_CHECK_S)
        n = self.gpi_errors_since(t0)
        if n and getattr(self, 'amp_retries', 0) < AMP_RETRIES:
            self.amp_retries = getattr(self, 'amp_retries', 0) + 1
            log('loud speaker: %d GPI DMA error(s) after the switch, the amplifier is probably silent: redoing the route (%d/%d)'
                % (n, self.amp_retries, AMP_RETRIES))
            self.switch_route(True)
        else:
            if n:
                log('loud speaker: GPI DMA errors again, giving up after %d retries' % getattr(self, 'amp_retries', 0))
            self.amp_retries = 0

    def device_switch_supported(self):
        try:
            with open(DEVICE_SWITCH) as f:
                return f.read().strip() == 'Y'
        except OSError:
            return False

    def switch_route(self, speaker):
        """Earpiece / loud speaker / USB headset."""
        use_usb = self.headset and not speaker and not self.usb_failed
        log('route: %s' % ('USB headset' if use_usb else 'loud speaker' if speaker else 'earpiece'))
        # classic в6: earpiece <-> loud speaker in place (kernel q6voice device_switch): the voice sessions stay, the vocproc
        # moves to the new backend. Re-creating the vocproc in the middle of a call crashed the ADSP audio PD while its
        # calibration was sent (2026-11-08 12:57:58 AfeDyb030, 3rd session of the call -> phone reset).
        if (not use_usb and not self.usb and self.hold and self.hold.poll() is None
                and self.device_switch_supported()):
            self.speaker = speaker
            self.rx_volume = None
            self.muted = False
            t0 = time.time()
            subprocess.run([MIXERS, 'route'] + (['speaker'] if speaker else []), stdout=subprocess.DEVNULL)
            if self.kernel_log_since(t0).count(SWITCH_ERR):
                log('in-place device switch failed, restarting the voice path')
                self.restart_route(speaker, use_usb)
                return
            log('route switched in place')
            self.check_speaker_amp(t0)
            return
        self.restart_route(speaker, use_usb)

    def restart_route(self, speaker, use_usb):
        """The old way (USB headset, kernel without device_switch): close CS-Voice, the voice sessions are re-created."""
        self.bridge_stop()
        if self.usb:
            self.set_playback(False)
        if self.hold:
            self.hold.terminate()
            try:
                self.hold.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.hold.kill()
            self.hold = None
        subprocess.run([MIXERS, 'stop'], stdout=subprocess.DEVNULL)
        # v40: let the ADSP finish releasing the voice session first; creating the new one right away crashed the
        # ADSP audio PD (23.10 22:19, the 2nd route switch of a call: audio_pd down 26 ms after the MVM session)
        time.sleep(1.0)
        self.speaker = speaker
        self.usb = use_usb
        self.rx_volume = None
        if self.muted:
            self.muted = False
        self.set_playback(self.usb)
        t0 = time.time()
        subprocess.run([MIXERS, 'start'] + (['speaker'] if speaker else []), stdout=subprocess.DEVNULL)
        self.hold = subprocess.Popen(HOLD, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if self.usb:
            mixer('TX_DEC0 Volume', TX_MUTED)
            mixer('RX_RX0 Digital Volume', 0)
            time.sleep(1.5)
            self.bridge_start()
        else:
            self.check_speaker_amp(t0)

    def poll_controls(self):
        """Mirror the call controls of the shell (mic mute, volume) onto the voice path (the voice audio does not go through PulseAudio)."""
        if not self.up:
            return GLib.SOURCE_CONTINUE
        state = read_state()
        muted = bool(state.get('mic_muted'))
        speaker = bool(state.get('speaker'))
        self.polls += 1
        if self.polls % 10 == 0:
            self.headset = self.usb_headset()	# plugged in / out during the call
            if not self.headset:
                self.usb_failed = False
        if (self.headset and not speaker and not self.usb_failed) != self.usb:
            if self.settled():
                self.switch_route(speaker)
            return GLib.SOURCE_CONTINUE
        if self.usb and self.bridge and self.bridge.poll() is not None:
            # the USB bridge died (it gives up after repeated pipeline failures): earpiece + phone microphone again
            log('USB bridge exited (%s): back to the earpiece' % self.bridge.returncode)
            self.bridge = None
            self.usb = False
            self.usb_failed = True
            self.set_playback(False)
            self.rx_volume = None
            self.muted = False
            mixer('TX_DEC0 Volume', TX_GAIN)
            mixer('RX_RX0 Digital Volume', RX_ZERO_DB)
        if self.usb:
            # headset mode: the mute button mutes the headset microphone; volume = PulseAudio volume of the USB sink
            if muted != self.muted:
                self.muted = muted
                src = subprocess.run(BRIDGE + ['find'], capture_output=True, text=True, env=PULSE_ENV).stdout.split()
                if len(src) == 2:
                    pulse('set-source-mute', src[1], '1' if muted else '0')
                log('USB headset microphone muted' if muted else 'USB headset microphone unmuted')
            return GLib.SOURCE_CONTINUE
        if speaker != self.speaker and self.settled():
            self.switch_route(speaker)
        if muted != self.muted:
            self.muted = muted
            mixer('TX_DEC0 Volume', TX_MUTED if muted else TX_GAIN)
            log('microphone muted' if muted else 'microphone unmuted')
        m = re.search(r'(\d+)%', pulse('get-sink-volume', '@DEFAULT_SINK@'))
        if m and self.speaker:
            p = int(m.group(1))
            gain = 0 if p <= 2 else max(1, min(AMP_FULL, round(AMP_FULL * 10 ** (-AMP_RANGE_DB * (100 - p) / 100 / 20))))
            if gain != self.rx_volume:
                self.rx_volume = gain
                mixer('Speaker Amp Gain', gain)
                log('loud speaker volume %d%% -> amp gain %d' % (p, gain))
        elif m:
            p = int(m.group(1))
            # linear in dB: 0 % = -30 dB, 100 % = +6 dB (a 5 % key step is ~1.8 dB, clearly audible); <= 2 % = silent
            vol = 0 if p <= 2 else max(RX_ZERO_DB - 30, min(RX_MAX, round(RX_ZERO_DB - 30 + p * 0.36)))
            if vol != self.rx_volume:
                self.rx_volume = vol
                mixer('RX_RX0 Digital Volume', vol)
                log('earpiece volume %d%% -> %d' % (p, vol))
        return GLib.SOURCE_CONTINUE

    def recheck_once(self):
        self.recheck()
        return GLib.SOURCE_REMOVE

    def recheck_timer(self):
        self.recheck()
        return GLib.SOURCE_CONTINUE

    def quit(self):
        self.loop.quit()
        return GLib.SOURCE_REMOVE

    def run(self):
        for iface, member in ((MM + '.Modem.Voice', 'CallAdded'),
                              (MM + '.Modem.Voice', 'CallDeleted'),
                              (MM + '.Call', 'StateChanged')):
            self.bus.signal_subscribe(MM, iface, member, None, None, Gio.DBusSignalFlags.NONE,
                                      lambda *a: GLib.idle_add(self.recheck_once), None)
        GLib.timeout_add_seconds(SAFETY_S, self.recheck_timer)
        GLib.timeout_add(CONTROL_POLL_MS, self.poll_controls)
        GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, self.quit)
        GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, self.quit)
        GLib.idle_add(self.recheck_once)
        try:
            self.loop.run()
        finally:
            self.stop()


if __name__ == '__main__':
    VoiceCall().run()
