#!/bin/sh
# M52XQ classic: numeric lock screen while the password is still the default 1111 (4 digits). The image already has a password, so the
# wizard skips its password page, and something in the first session wrote PasswordDisplayHint=0 (passphrase prompt for 1111). Runs at
# boot and when the wizard ends (m52xq-password-hint.path). A changed password is left alone.
H=$(sed -n 's/^user:\([^:]*\):.*/\1/p' /etc/shadow)
case "$H" in
'$6$'*) ;;
*) exit 0 ;;
esac
SALT=$(echo "$H" | cut -d'$' -f3)
[ "$(openssl passwd -6 -salt "$SALT" 1111)" = "$H" ] || exit 0
O=/org/freedesktop/Accounts/User$(id -u user)
I=com.lomiri.AccountsService.SecurityPrivacy
[ "$(busctl get-property org.freedesktop.Accounts $O $I PasswordDisplayHint 2>/dev/null)" = "i 1" ] && exit 0
busctl set-property org.freedesktop.Accounts $O $I PasswordDisplayHint i 1 && echo "m52xq-password-hint: numeric prompt for the default password"
