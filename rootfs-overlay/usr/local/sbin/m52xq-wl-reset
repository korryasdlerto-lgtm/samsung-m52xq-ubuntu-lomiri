#!/usr/bin/python3
# M52XQ: hold WL_EN (TLMM 84) of the WCN6750 low for N seconds (default 1), with WPSS stopped. The line belongs to the WPSS firmware (stock btpower
# only reads it). After a WPSS crash the Wi-Fi part of the chip kept its state and every start died with "ccpm_mhi.c:397:mhi_issue_request Failed";
# found on classic 2026-11-06. Uses the GPIO v2 character device: never debugfs gpio on this phone.
import fcntl, glob, os, struct, sys, time
GET_LINE = 0xC250B407
OFFSET, OUTPUT, INPUT = 84, 1 << 3, 1 << 2
def chip():
    for c in sorted(glob.glob('/dev/gpiochip*')):
        b = bytearray(68)
        fd = os.open(c, os.O_RDONLY)
        fcntl.ioctl(fd, 0x8044B401, b)
        if b'f100000.pinctrl' in bytes(b[32:64]):
            return fd
        os.close(fd)
    sys.exit('no TLMM gpiochip')
def request(fd, flags):
    r = bytearray(592)
    struct.pack_into('I', r, 0, OFFSET)
    r[256:264] = b'm52xq-wl'
    struct.pack_into('Q', r, 288, flags)
    struct.pack_into('I', r, 560, 1)
    fcntl.ioctl(fd, GET_LINE, r)
    return struct.unpack_from('i', r, 588)[0]
fd = chip()
line = request(fd, OUTPUT)	# output, low
time.sleep(float(sys.argv[1]) if len(sys.argv) > 1 else 1)
os.close(line)
os.close(request(fd, INPUT))	# give the line back to WPSS
