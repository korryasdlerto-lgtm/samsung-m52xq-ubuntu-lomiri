<?xml version="1.0" encoding="UTF-8"?>
<!-- m52xq (убунтутач24/003): "a call is going on" flag for Lomiri's Shell.qml (the Ubuntu Touch callManager.hasCalls runs on telepathy-ofono, we have
     ModemManager). Set by m52xq-incall-proximity, read by the patched Shell.qml: the dialer is shown over the lock screen while it is true. -->
<schemalist>
  <schema id="org.m52xq.Calls" path="/org/m52xq/calls/">
    <key name="active" type="b">
      <default>false</default>
      <summary>A modem call is going on</summary>
    </key>
    <!-- classic в6: the blue call bar (Panel/ActiveCallHint) shows the time since the answer and the contact / number -->
    <key name="active-since" type="x">
      <default>0</default>
      <summary>Unix time the foreground call was answered (0 = not answered yet)</summary>
    </key>
    <key name="number" type="s">
      <default>''</default>
      <summary>Phone number of the foreground call</summary>
    </key>
  </schema>
</schemalist>
